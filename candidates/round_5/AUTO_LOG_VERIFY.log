eff)}')\n\n# Constant coefficient:\n# 5752500*u^3 + 20767500*u^2*(v-1) + 20767500*u^2 + 27887500*u*(v-1)^2 + 55775000*u*(v-1) + 27887500*u + 12872500*(v-1)^3 + 38617500*(v-1)^2 + 38617500*(v-1) + 12872500\nC_coeff_expanded = (5752500*u**3 + 20767500*u**2*(v-1) + 20767500*u**2 \n    + 27887500*u*(v-1)**2 + 55775000*u*(v-1) + 27887500*u \n    + 12872500*(v-1)**3 + 38617500*(v-1)**2 + 38617500*(v-1) + 12872500)\nC_coeff = sp.expand(C_coeff_expanded)\nprint(f'\\nConstant coefficient in (u,v):')\nprint(f'  {sp.collect(C_coeff, [u, v])}')\n\n# Try to factor\nC_factored = sp.factor(C_coeff)\nprint(f'  Factored: {C_factored}')\n\n# Check: the numerator is  R_coeff * R - C_coeff\n# And L2 = -c^4 * (R_coeff * R - C_coeff) / (80000000000 * v^{79/20} * (u+v)^{59/20})\n# For L2 >= 0, we need R_coeff * R - C_coeff <= 0\n# i.e., R <= C_coeff / R_coeff\n\nprint(f'\\nRatio C_coeff / R_coeff (minimum over z = u/v):')\nz = sp.Symbol('z', nonneg=True)\n# Substitute u = z*v: R_coeff = v^3 * (28z^3 + 136z^2 + 237z + 203)\n# C_coeff = v^3 * (5752500*z^3 + 20767500*z^2 + 27887500*z + 12872500)\nR_poly = 28*z**3 + 136*z**2 + 237*z + 203\nC_poly = 5752500*z**3 + 20767500*z**2 + 27887500*z + 12872500\nratio = C_poly / R_poly\nprint(f'  R_poly(z) = {R_poly}')\nprint(f'  C_poly(z) = {C_poly}')\nprint(f'  ratio = {ratio}')\n\n# Find critical points\nratio_diff = sp.diff(ratio, z)\nratio_diff_simplified = sp.simplify(ratio_diff)\nprint(f'  d(ratio)/dz simplified numerator = {sp.factor(sp.numer(sp.together(ratio_diff)))}')\n\n# Evaluate ratio at z=0 and z->inf\nprint(f'  ratio(z=0) = {sp.Rational(12872500, 203)} = {float(sp.Rational(12872500, 203)):.2f}')\nprint(f'  ratio(z->inf) = {sp.Rational(5752500, 28)} = {float(sp.Rational(5752500, 28)):.2f}')\n\n# Check ratio at several z values\nfor zv in [0, 0.5, 1, 2, 5, 10, 100]:\n    val = float(C_poly.subs(z, zv) / R_poly.subs(z, zv))\n    print(f'  ratio(z={zv}) = {val:.2f}')\n\" 2>&1","description":"Analyze L2 condition structure in detail","timeout