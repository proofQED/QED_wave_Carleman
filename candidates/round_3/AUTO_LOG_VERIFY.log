/2500^2 * [49^2*(u+v)^2 - (u-v)^2]\")\nprint(\"  = phi^2/2500^2 * (48u + 50v)(50u + 48v)\")\nprint()\n\n# phi_xt\nphi_xt = sp.diff(phi, x, t)\nphi_xt_simplified = sp.simplify(phi_xt)\nprint(\"phi_xt =\", phi_xt_simplified)\n\n# phi_xt = (1/50)^2 * (1+t)^(1/50-1) * (1+x)^(1/50-1) = phi/(2500*(1+t)(1+x))\n# So phi_xt = phi / (2500*(1+t)*(1+x))\n# c^2*phi_xt^2 = c^2 * phi^2 / (2500^2 * (1+t)^2 * (1+x)^2) = phi^2 * c^2 / (2500^2 * (1+t)^2 * (1+x)^2)\n# = phi^2 / 2500^2 * uv  (since u*v = c^2/((1+t)^2*(1+x)^2))\n# Wait: u = 1/(1+t)^2, v = c^2/(1+x)^2, so u*v = c^2/((1+t)^2*(1+x)^2)\n# and c^2*phi_xt^2 = phi^2 * c^2 / (2500^2*(1+t)^2*(1+x)^2) = phi^2/(2500^2) * u*v/1\n# Wait: u*v = c^2/((1+t)^2*(1+x)^2)\n# c^2*phi_xt^2 = c^2 * phi^2/(2500*(1+t)*(1+x))^2 = c^2*phi^2/(2500^2*(1+t)^2*(1+x)^2) = phi^2*uv/2500^2\n# Hmm, let me check: u = 1/(1+t)^2, v = c^2/(1+x)^2\n# u*v = c^2/((1+t)^2*(1+x)^2)\n# c^2 * phi_xt^2 = c^2 * phi^2/(2500^2*(1+t)^2*(1+x)^2) = phi^2/(2500^2) * c^2/((1+t)^2*(1+x)^2) = phi^2/(2500^2) * u * v / c^2 * c^2 \n\n# Let me just be more careful. \n# u*v = c^2 / [(1+t)^2 * (1+x)^2]\n# c^2 * phi_xt^2 = c^2 * [phi / (2500*(1+t)*(1+x))]^2 = c^2 * phi^2 / [2500^2 * (1+t)^2 * (1+x)^2]\n# = phi^2/2500^2 * c^2/[(1+t)^2*(1+x)^2] = phi^2/2500^2 * uv\nprint()\nprint(\"c^2*phi_xt^2 = phi^2/(2500^2) * uv\")\nprint()\nprint(\"So: L1^2 - L^2 - c^2*phi_xt^2 = phi^2/2500^2 * [(48u+50v)(50u+48v) - uv]\")\nprint()\n\n# Expand (48u+50v)(50u+48v)\n# = 2400u^2 + 48*48*uv + 50*50*uv + 2400v^2\n# = 2400u^2 + (2304 + 2500)uv + 2400v^2\n# = 2400u^2 + 4804uv + 2400v^2\n# Subtract uv: 2400u^2 + 4803uv + 2400v^2\nprint(\"(48u+50v)(50u+48v) = 2400u^2 + 4804uv + 2400v^2\")\nprint(\"Minus uv: 2400u^2 + 4803uv + 2400v^2\")\nprint()\n\n# Check discriminant of quadratic form 2400u^2 + 4803uv + 2400v^2\n# Discriminant = 4803^2 - 4*2400*2400\ndisc = 4803**2 - 4*2400*2400\nprint(f\"Discriminant of 2400u^2 + 4803uv + 2400v^2: {disc}\")\nprint(f\"4803^2 = {4803**2}\")\nprint(f\"4*2400^2 = {4*2400**2}