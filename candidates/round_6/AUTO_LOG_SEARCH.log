t(T[idx]), c_val)\n    except:\n        pass\n\nprint(f\"Extended L2 check: min={global_min:.4e}\")\nif worst:\n    print(f\"  at x={worst[0]:.3e}, t={worst[1]:.3e}, c={worst[2]:.3e}\")\n\n# Check sufficient condition\nphi = ops['phi']\nphi_xt = sp.diff(phi, x, t)\nsuff = sp.simplify(ops['L1']**2 - ops['L']**2 - c**2 * phi_xt**2)\nstatus_suff, info_suff = numerical_check(suff)\nprint(f\"Sufficient: {status_suff}, min={info_suff.get('min', 'N/A')}\")\n\nPYEOF\n","description":"Numerical verification of lam=-1/200 candidate","timeout":180000}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":4484,"cache_read_input_tokens":165304,"cache_creation":{"ephemeral_5m_input_tokens":4484,"ephemeral_1h_input_tokens":0},"output_tokens":1},"context_management":null},"parent_tool_use_id":null,"session_id":"760dc304-8a9b-499d-91d9-5ac15b9d654b","uuid":"dd7fb858-b34b-452c-9aec-c4ba139a97ae"}
